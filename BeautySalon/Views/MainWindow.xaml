<Window x:Class="BeautySalon.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BeautySalon"
        Title="Салон красоты — Управление услугами"
        Icon="/Resources/beauty_logo.ico"
        Height="760" Width="1150"
        MinHeight="560" MinWidth="900"
        FontFamily="Tahoma"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="SecondaryBackground" Color="#E1E4FF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4A6D"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка с логотипом -->
        <Border Grid.Row="0"
                Background="{StaticResource SecondaryBackground}"
                CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/beauty_logo.png" Height="48" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Салон красоты"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Управление услугами салона"
                               FontSize="12" Foreground="#555"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Панель действий -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AddServiceButton"
                    Content="Добавить услугу"
                    Style="{StaticResource AccentButton}"
                    Click="AddServiceButton_Click"/>
            <Button x:Name="AddAppointmentButton"
                    Content="Записать клиента на услугу"
                    Style="{StaticResource AccentButton}"
                    Click="AddAppointmentButton_Click"/>
            <Button x:Name="RefreshButton"
                    Content="Обновить"
                    Style="{StaticResource SecondaryButton}"
                    Click="RefreshButton_Click"/>
        </StackPanel>

        <!-- Вкладки -->
        <TabControl Grid.Row="2" FontFamily="Tahoma">
            <TabItem Header="Услуги">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl x:Name="ServicesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Width="360">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="80" Height="80"
        Background="#F2C9C9" CornerRadius="4">
                                            <Image Stretch="UniformToFill">
                                                <Image.Source>
                                                    <Binding Path="MainImagePath">
                                                        <Binding.Converter>
                                                            <local:ImagePathConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,4,0,0" FontSize="13">
                                                <Run Text="{Binding CostWithDiscount, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                                <Run Text=" рублей за "/>
                                                <Run Text="{Binding DurationInMinutes, Mode=OneWay}"/>
                                                <Run Text=" минут"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Text="{Binding Discount, StringFormat=* скидка {0}%}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDiscount, Mode=OneWay}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="редактировать"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="EditServiceButton_Click"
                                                        Tag="{Binding}"/>
                                                <Button Content="удалить"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="DeleteServiceButton_Click"
                                                        Tag="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ближайшие записи">
                <DataGrid x:Name="UpcomingGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          FontFamily="Tahoma">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Клиент"
                                            Binding="{Binding ClientFullName}" Width="*"/>
                        <DataGridTextColumn Header="Услуга"
                                            Binding="{Binding ServiceTitle}" Width="*"/>
                        <DataGridTextColumn Header="Начало"
                                            Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm}"
                                            Width="160"/>
                        <DataGridTextColumn Header="Комментарий"
                                            Binding="{Binding Comment}" Width="*"/>
                        <DataGridTemplateColumn Header="Действия" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Удалить"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="DeleteAppointmentButton_Click"
                                            Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>