<Window x:Class="BeautySalon.Views.AppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись клиента на услугу"
        Icon="/Resources/beauty_logo.ico"
        Height="480" Width="560"
        MinHeight="440" MinWidth="520"
        FontFamily="Tahoma"
        Background="White"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="SecondaryBackground" Color="#E1E4FF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4A6D"/>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="/Resources/beauty_logo.png" Height="36" Margin="0,0,10,0"/>
            <TextBlock Text="Новая запись" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Клиент" FontWeight="SemiBold"/>
        <ComboBox x:Name="ClientBox" Grid.Row="2" Margin="0,4,0,12"
                  Padding="6"
                  DisplayMemberPath="FullName"/>

        <TextBlock Grid.Row="3" Text="Услуга" FontWeight="SemiBold"/>
        <ComboBox x:Name="ServiceBox" Grid.Row="4" Margin="0,4,0,12"
                  Padding="6"
                  DisplayMemberPath="Title"/>

        <TextBlock Grid.Row="5" Text="Дата и время начала" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,4,0,12">
            <DatePicker x:Name="DatePicker" Width="180" Margin="0,0,10,0"/>
            <TextBox x:Name="TimeBox" Width="100" Padding="6" Text="10:00"/>
        </StackPanel>

        <StackPanel Grid.Row="7">
            <TextBlock Text="Комментарий" FontWeight="SemiBold"/>
            <TextBox x:Name="CommentBox" Margin="0,4,0,0"
                     Padding="6" Height="80"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить"
                    Width="120"
                    Style="{StaticResource AccentButton}"
                    Click="SaveButton_Click"/>
            <Button Content="Отмена"
                    Width="100"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>